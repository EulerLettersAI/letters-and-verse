---
interface Props {
  title: string;
  description: string;
  date: Date;
  author: string;
  href: string;
  kind: string;
}

const { title, description, date, author, href, kind } = Astro.props;
const formattedDate = new Intl.DateTimeFormat('ar-JO', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(date);
---

<article class="entry-card">
  <p class="entry-kind">{kind}</p>
  <h3><a href={href}>{title}</a></h3>
  <p>{description}</p>
  <p class="entry-meta">
    <strong>بقلم {author}</strong>
    <span aria-hidden="true">·</span>
    <time datetime={date.toISOString()}>{formattedDate}</time>
  </p>
</article>
