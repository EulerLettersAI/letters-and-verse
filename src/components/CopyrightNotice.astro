---
interface Props {
  author: string;
  language: 'ar' | 'en';
  publishedAt: Date;
}

const { author, language, publishedAt } = Astro.props;
const year = publishedAt.getUTCFullYear();
---

<aside
  class="copyright-notice"
  lang={language}
  dir={language === 'ar' ? 'rtl' : 'ltr'}
  aria-label={language === 'ar' ? 'إشعار حقوق النشر' : 'Copyright notice'}
>
  <strong>© {year} <bdi>{author}</bdi>. {language === 'ar' ? 'جميع الحقوق محفوظة.' : 'All rights reserved.'}</strong>
  <span>
    {language === 'ar'
      ? 'فضلاً، نرجو التكرم بعدم نسخ هذا النص أو إعادة نشره أو توزيعه أو ترجمته أو تعديله، كليًا أو جزئيًا، دون إذن كتابي مسبق من المؤلف.'
      : 'Please kindly refrain from copying, republishing, distributing, translating, or adapting this text, in whole or in part, without the author’s prior written permission.'}
  </span>
</aside>
