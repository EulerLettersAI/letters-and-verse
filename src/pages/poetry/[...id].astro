---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import AuthorLink from '../../components/AuthorLink.astro';

export const getStaticPaths = (async () => {
  const entries = await getCollection('poetry', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const locale = entry.data.language === 'ar' ? 'ar-JO' : 'en-GB';
const date = new Intl.DateTimeFormat(locale, { dateStyle: 'long' }).format(entry.data.publishedAt);
const coverSrc = entry.data.cover ? `${import.meta.env.BASE_URL}${entry.data.cover.src}` : undefined;
const coverSrcSmall = coverSrc?.replace(/\.webp$/, '-768.webp');
const showDescription = entry.data.description.trim() !== entry.data.title.trim();
const poetryTypeLabel = entry.data.poetryType === 'classical'
  ? `شعر عمودي${entry.data.meter ? ` من بحر ${entry.data.meter}` : ''}`
  : 'شعر حر';
const poemClass = [
  'prose',
  'poem',
  entry.data.poetryType === 'classical' ? 'classical-poem' : 'free-poem',
].filter(Boolean).join(' ');
---

<SiteLayout
  title={`${entry.data.title} | رسائل وقصائد`}
  description={entry.data.description}
  lang={entry.data.language}
  image={coverSrc}
  type="article"
>
  <article class="prose-shell poem-page">
    <a class="back-link" href={import.meta.env.BASE_URL}>← جميع النصوص</a>
    <header class="article-header">
      <h1>{entry.data.title}</h1>
      <p class="poetry-type">{poetryTypeLabel}</p>
      {showDescription && <p>{entry.data.description}</p>}
      <div class="article-meta"><AuthorLink author={entry.data.author} /><time datetime={entry.data.publishedAt.toISOString()}>{date}</time></div>
    </header>
    {entry.data.showCoverOnPage && coverSrc && entry.data.cover && (
      <figure class="entry-cover">
        <img
          src={coverSrc}
          srcset={coverSrcSmall ? `${coverSrcSmall} 768w, ${coverSrc} 1536w` : undefined}
          sizes="(max-width: 1000px) calc(100vw - 44px), 960px"
          alt={entry.data.cover.alt}
          width="1536"
          height="1024"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </figure>
    )}
    <div class={poemClass}><Content /></div>
  </article>
</SiteLayout>

<script>
  const verseNotes = Array.from(document.querySelectorAll<HTMLDetailsElement>('.classical-poem details.verse-with-note'));

  verseNotes.forEach((note) => {
    note.addEventListener('toggle', () => {
      if (!note.open) return;

      verseNotes.forEach((otherNote) => {
        if (otherNote !== note) otherNote.removeAttribute('open');
      });
    });

    note.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !note.open) return;
      note.removeAttribute('open');
      note.querySelector<HTMLElement>('summary')?.focus();
    });
  });
</script>
