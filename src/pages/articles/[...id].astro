---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import AuthorLink from '../../components/AuthorLink.astro';

export const getStaticPaths = (async () => {
  const entries = await getCollection('articles', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const locale = entry.data.language === 'ar' ? 'ar-JO' : 'en-GB';
const date = new Intl.DateTimeFormat(locale, { dateStyle: 'long' }).format(entry.data.publishedAt);
const coverSrc = entry.data.cover ? `${import.meta.env.BASE_URL}${entry.data.cover.src}` : undefined;
const coverSrcSmall = coverSrc?.replace(/\.webp$/, '-768.webp');
const videoSrc = entry.data.video ? `${import.meta.env.BASE_URL}${entry.data.video.src}` : undefined;
const videoPosterSrc = entry.data.video?.poster
  ? `${import.meta.env.BASE_URL}${entry.data.video.poster}`
  : coverSrc;
const showDescription = entry.data.description.trim() !== entry.data.title.trim();
---

<SiteLayout
  title={`${entry.data.title} | رسائل وقصائد`}
  description={entry.data.description}
  lang={entry.data.language}
  image={coverSrc}
  type="article"
>
  <article class="prose-shell">
    <a class="back-link" href={import.meta.env.BASE_URL}>← جميع النصوص</a>
    <header class="article-header">
      <p class="kicker">{entry.data.language === 'ar' ? 'رسالة' : 'Letter'}</p>
      <h1>{entry.data.title}</h1>
      {showDescription && <p>{entry.data.description}</p>}
      <div class="article-meta"><AuthorLink author={entry.data.author} /><time datetime={entry.data.publishedAt.toISOString()}>{date}</time></div>
    </header>
    {videoSrc && entry.data.video && (
      <figure class="entry-video">
        <video
          controls
          playsinline
          preload="metadata"
          poster={videoPosterSrc}
          width="384"
          height="720"
          aria-label={`${entry.data.title} — video reading`}
        >
          <source src={videoSrc} type="video/mp4" />
          Your browser does not support embedded video.
        </video>
        {entry.data.video.caption && <figcaption>{entry.data.video.caption}</figcaption>}
      </figure>
    )}
    <div class="prose article-prose">
      {!videoSrc && coverSrc && entry.data.cover && (
        <figure class="entry-cover">
          <img
            src={coverSrc}
            srcset={coverSrcSmall ? `${coverSrcSmall} 768w, ${coverSrc} 1536w` : undefined}
            sizes="(max-width: 700px) calc(100vw - 44px), 320px"
            alt={entry.data.cover.alt}
            width="1536"
            height="1024"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </figure>
      )}
      <Content />
    </div>
  </article>
</SiteLayout>
