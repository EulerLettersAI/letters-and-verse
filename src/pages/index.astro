---
import { getCollection } from 'astro:content';
import EntryCard from '../components/EntryCard.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const byNewest = (a: { data: { publishedAt: Date } }, b: { data: { publishedAt: Date } }) =>
  b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf();
const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(byNewest);
const poems = (await getCollection('poetry', ({ data }) => !data.draft)).sort(byNewest);
const arabicArticles = articles.filter((entry) => entry.data.language === 'ar');
const englishArticles = articles.filter((entry) => entry.data.language === 'en');
const arabicPoems = poems.filter((entry) => entry.data.language === 'ar');
const base = import.meta.env.BASE_URL;
const isParked = articles.length === 0 && poems.length === 0;
---

<SiteLayout
  title={isParked ? 'قريبًا | رسائل وقصائد' : undefined}
  description={isParked ? 'مساحة عربية للرسائل والقصائد، تُطلق قريبًا.' : undefined}
  parked={isParked}
>
  {isParked ? (
    <section class="parking-page" aria-labelledby="parking-title">
      <div class="parking-glow parking-glow-one" aria-hidden="true"></div>
      <div class="parking-glow parking-glow-two" aria-hidden="true"></div>
      <div class="parking-card">
        <div class="parking-mark" aria-hidden="true">و</div>
        <h1 id="parking-title" class="page-title"><span lang="en" dir="ltr">Letters &amp; Verse</span><span lang="ar" dir="rtl">رسائل وقصائد</span></h1>
        <span class="parking-rule" aria-hidden="true"></span>
        <p class="parking-copy">نُعِدّ مكانًا للتأمل والمعرفة والشعر.<br />سنفتح أبوابه قريبًا.</p>
        <p class="parking-status"><span aria-hidden="true"></span> قيد الإعداد</p>
      </div>
    </section>
  ) : (
    <>
  <section class="hero">
    <div class="shell">
      <h1 class="page-title"><span lang="en" dir="ltr">Letters &amp; Verse</span><span lang="ar" dir="rtl">رسائل وقصائد</span></h1>
      <p class="hero-copy">رسائل تتأمل في المعرفة والحياة، وقصائد تنصت إلى ما بينهما.</p>
    </div>
  </section>

  <section class="content-section english-section" id="english-letters" lang="en" dir="ltr" aria-labelledby="english-letters-heading">
    <div class="section-heading">
      <h2 id="english-letters-heading">Letters</h2>
      <span>{englishArticles.length} {englishArticles.length === 1 ? 'Letter' : 'Letters'}</span>
    </div>
    {englishArticles.length > 0 ? (
      <div class="entry-grid">
        {englishArticles.map((article) => (
          <EntryCard
            title={article.data.title}
            description={article.data.description}
            date={article.data.publishedAt}
            author={article.data.author}
            href={`${base}articles/${article.id}/`}
            language="en"
            cover={article.data.cover ? `${base}${article.data.cover.src}` : undefined}
            coverAlt={article.data.cover?.alt}
          />
        ))}
      </div>
    ) : (
      <p class="empty-state">The first English letter will be published soon.</p>
    )}
  </section>

  <section class="content-section arabic-section" lang="ar" dir="rtl" aria-label="النصوص العربية">
    <section class="content-category" id="letters" aria-labelledby="arabic-letters-heading">
      <div class="section-heading">
        <h2 id="arabic-letters-heading">الرسائل</h2>
        <span>{arabicArticles.length} {arabicArticles.length === 1 ? 'رسالة' : 'رسائل'}</span>
      </div>
      {arabicArticles.length > 0 ? (
        <div class="entry-grid">
          {arabicArticles.map((article) => (
            <EntryCard
              title={article.data.title}
              description={article.data.description}
              date={article.data.publishedAt}
              author={article.data.author}
              href={`${base}articles/${article.id}/`}
              language="ar"
              cover={article.data.cover ? `${base}${article.data.cover.src}` : undefined}
              coverAlt={article.data.cover?.alt}
            />
          ))}
        </div>
      ) : (
        <p class="empty-state">ستُنشر الرسالة الأولى قريبًا.</p>
      )}
    </section>

    <section class="content-category" id="verse" aria-labelledby="arabic-poetry-heading">
      <div class="section-heading">
        <h2 id="arabic-poetry-heading">القصائد</h2>
        <span>{arabicPoems.length} {arabicPoems.length === 1 ? 'قصيدة' : 'قصائد'}</span>
      </div>
      {arabicPoems.length > 0 ? (
        <div class="entry-grid">
          {arabicPoems.map((poem) => (
            <EntryCard
              title={poem.data.title}
              description={poem.data.description}
              date={poem.data.publishedAt}
              author={poem.data.author}
              href={`${base}poetry/${poem.id}/`}
              language="ar"
              cover={poem.data.cover ? `${base}${poem.data.cover.src}` : undefined}
              coverAlt={poem.data.cover?.alt}
            />
          ))}
        </div>
      ) : (
        <p class="empty-state">ستُنشر القصيدة الأولى قريبًا.</p>
      )}
    </section>
  </section>
    </>
  )}
</SiteLayout>
